  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueHandler
  combatTrigger: {fileID: 649356917}
  inputActions: {fileID: -944628639613478452, guid: 052faaac586de48259a63d0c4782560b, type: 3}
  TextCanv: {fileID: 1394950306}
  Player: {fileID: 1478224543}
  LanceBlock: {fileID: 484649845}
  Button1: {fileID: 194756675}
  Button2: {fileID: 370744382}
  Button3: {fileID: 518966065}
  CharName: 2
  DisplayText: "Th3 fuck U w4nt?;  4nd? U lo5t. D3al w1th 1t.;  8ruv, U d1dn\u2019t
    w4nt t0 kn0w. Th4t\u2019s Y y0u\u2019re 1n th1s me55. N0w, g3t th3 fuck 0ut my
    b4r.;  L1st3n, crust punk, I\u201911 giv3 y0u 0ne gam3. U w1n, 1\u2019ll t3ll
    y0u wh4t y0u l0st. 1 w1n, U d0n\u2019t com3 b4ck h3re aga1n.;  1 alr3ady g0t
    wh4t 1 w4nt3d.;  \u2026;  Y0ur s0u1.;  Y3p. L0st ur m3mori3s, t00. 8ut th4t wa5
    0n ur 0wn r3qu3st\u2013 a g1ft fr0m urs truly.;  La5t t1m3 I 0ff3rd 3nlight3nm3nt
    I was d3t3st3d. Y0ur k1nd l1k3s to b3 d3ns3.;  Y0u t0ld m3 U d1dn\u2019t w4nt
    t0 kn0w. T00 much sh4me.;  T00 lat3. 1f U r3ally w4nt t0 kn0w U sh0uld a5k y0urs3lf:
    Wh4t c0uld h4v3 p0ss1bly b33n w0rth th15?; Th4ts y y0u\u2019r3 n0t th3 K1NG.
    N0w, g3t l0st. N3v3r c0m3 8ack. "
  ButtonText: "You're the one that beat my ass.; Well, aren't you a wet blanket?; 
    I need to know what I wanted from you.; Dude, last night was a total blackout.;
    I don\u2019t even know what I lost.;  I\u2019ll play you!; Come on, dude!; Scared
    you\u2019ll lose?;  What am I wagering?; That's it, you just want me out?;  Begin; 
    So? What did I lose?;  ... what?; No\u2013 I\u2019d remember!; I wouldn\u2019t
    have bet that!;  A gift?;  No! What did I even want?;  I want to know now!; I\u2019ll
    play you for my soul back!;  ...; Retry "
  TextOBJ: {fileID: 1105010927}
  BarMusicOBJ: {fileID: 255530400}
  BattleMusicOBJ: {fileID: 116659735}
  OtisBattleTheme: {fileID: 8300000, guid: a28e441d20a59514fb9bb9ae21157ecc, type: 3}
