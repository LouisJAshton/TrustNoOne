  m_Script: {fileID: 11500000, guid: 66f14511c1ca30b44b628a00196b299f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueHandler
  combatTrigger: {fileID: 10651265}
  inputActions: {fileID: -944628639613478452, guid: 052faaac586de48259a63d0c4782560b, type: 3}
  TextCanv: {fileID: 1394950306}
  Button1: {fileID: 194756675}
  Button2: {fileID: 370744382}
  Button3: {fileID: 518966065}
  CharName: 0
  DisplayText: "What can I get for\u2013 hey, weren\u2019t you just in here?; Heh,
    yeah you were. You got hella crunk, too. Take this.; Drink it. It\u2019ll make
    ya feel better.; Oh, you had some fun. Come to play some more? Don\u2019t tell
    me you forgot how to play!; Need me to go over it again, scrub, or ya think ya
    got it?; Good. I got things to do.; Like I said, I'm busy. But, I could go on
    break if you wanna play. If you win, I'll tell you more about last night.; But
    if I win? Well, I'm pretty sure you don't have anything left.; Sorry, kid. You
    ain\u2019t got nothin\u2019 for me.; You're on, Ash.; I\u2019ll be damned.; There's
    not much more to say, really. You came in last night with bright eyes, hopes,
    and treasures to gamble.; You wanted something real bad. We could see the fire
    in your eyes. You had a good streak there in the beginning...; But I guess your
    luck fell short. It doesn\u2019t matter. It\u2019s just a game.; Look, kid, I
    gotta get back to work.; Poor sap. Better luck next time."
  ButtonText: "I don\u2019t think so\u2026; I don\u2019t feel good, dude.; Uh, what
    is this?; Thanks, bro.; So\u2026 what was I doing here last night?; Must have
    been a good night. Tell me about it?; Um\u2026 remind me.; No, no, dude. I know
    how to play.; My head hurts\u2026 explain it again?; Yeah, no, I totally get
    it.; What else happened last night?; So, I just got wasted and played cards?;
    Well. You wanna play?; Okay...; I\u2019ve got a lil dust bunny in my pocket?;
    I\u2019ll owe you a favour.; I\u2019ve got my name. Ash.; Begin; So? Tell me
    more.; Good game. Now, what about last night?; ...; ...; It doesn\u2019t explain
    why I\u2019m so dazed.; I lost so hard I blacked out?; What did I want? How much
    did I lose?; But\u2013; Wait\u2013; Retry; ... "
  TextOBJ: {fileID: 1105010927}
  roundOverEvent: {fileID: 11400000, guid: fabf0db1727fdc84d8d0f8e93f55048e, type: 2}
